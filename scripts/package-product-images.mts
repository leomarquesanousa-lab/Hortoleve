import { mkdir, readFile, writeFile, open } from "node:fs/promises";
import path from "node:path";
import { initialContent } from "../src/modules/cms/initial-content.ts";
import { inventoryImages, productImagePaths, digest } from "../src/modules/cms/media-migration.ts";
import { storageImageURL } from "../src/modules/catalog/storage-images.ts";

// Preparação local: não carrega .env, não conecta ao banco e não usa o storage.
const output = path.resolve(".cache/hostinger-media-25-products");
await mkdir(path.dirname(output), { recursive: true });
await mkdir(output); // Recusa sobrescrever pacote anterior.
await mkdir(path.join(output, "products"));
const products = initialContent.filter(item => item.resource === "produtos");
const assets = await inventoryImages("public", productImagePaths(products));
const entries = assets.map(asset => ({
    originalName: path.posix.basename(asset.source), originalURL: asset.source,
    destinationName: asset.filename, destination: "products/" + asset.filename,
    publicURL: "/media/products/" + asset.filename, sha256: asset.sha256, bytes: asset.bytes,
    products: products.filter(product => productImagePaths([product]).includes(asset.source)).map(product => ({
        id: product.id, name: String(product.data.name), slug: String(product.data.slug),
        cardCover: product.data.cardImage === storageImageURL(asset.source),
        galleryPositions: (product.data.gallery as { src: string }[]).flatMap((image, index) => image.src === storageImageURL(asset.source) ? [index + 1] : []),
    })),
}));
const unique = [...new Map(assets.map(asset => [asset.filename, asset])).values()];
for (const asset of unique) {
    const bytes = await readFile(path.join("public", asset.source.slice(1)));
    if (digest(bytes) !== asset.sha256) throw Error("Origem mudou durante a preparação.");
    const destination = path.join(output, "products", asset.filename);
    const handle = await open(destination, "wx", 0o600);
    try { await handle.writeFile(bytes); } finally { await handle.close(); }
    if (digest(await readFile(destination)) !== asset.sha256) throw Error("Cópia local divergente.");
}
const expected = unique.map(asset => ({ filename: asset.filename, sha256: asset.sha256, bytes: asset.bytes }));
const manifest = { version: 1, products: products.length, sourcePaths: entries.length, uniqueFiles: unique.length,
    totalImageBytes: unique.reduce((sum, asset) => sum + asset.bytes, 0),
    targetDirectory: "/home/u604106388/hortoleve-storage/products", entries };
const content = JSON.stringify(manifest, null, 2);
await writeFile(path.join(output, "manifest.json"), content, { flag: "wx" });
await writeFile(path.join(output, "manifest.sha256"), digest(content) + "  manifest.json\n", { flag: "wx" });
await writeFile("src/modules/cms/storage-assets.generated.ts", "// Expected immutable product assets. Generated by package-product-images.mts.\nexport const storageAssets = " + JSON.stringify(expected, null, 2) + ";\n");
await writeFile("src/modules/cms/product-images-plan.json", JSON.stringify({ version: 1, productsStatic: products.length, cmsInspected: false, productsCMS: null, uniqueFiles: unique.length, assets: assets.map(asset => ({ ...asset, target: "/media/products/" + asset.filename })) }, null, 2));
console.log(JSON.stringify({ output, products: products.length, sourcePaths: entries.length, uniqueFiles: unique.length, totalImageBytes: manifest.totalImageBytes, manifestSHA256: digest(content) }));
