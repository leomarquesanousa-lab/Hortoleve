# Somente placeholders. Manter .env.local fora do Git.
# Runtime: host Neon com -pooler e TLS obrigatório.
DATABASE_URL="postgresql://USER:PASSWORD@PROJECT-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
# CLI/migrações futuras: conexão direta, em uma branch de DESENVOLVIMENTO.
DIRECT_URL="postgresql://USER:PASSWORD@PROJECT.REGION.aws.neon.tech/DATABASE?sslmode=require"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""
# Marcar true somente após aplicar a migração autorizada no banco de desenvolvimento.
ADMIN_DATABASE_READY="false"
# Cabeçalho normalizado pelo proxy confiável; não aceitar cabeçalhos arbitrários da Internet.
ADMIN_TRUSTED_IP_HEADER=""
ADMIN_BOOTSTRAP_ALLOWED="false"

# CMS: ativar somente após importação autorizada e validação em homologação.
CMS_PUBLIC_ENABLED="false"
CMS_LEADS_ENABLED="false"
CMS_IMPORT_ALLOWED="false"
# Uploads duráveis S3/R2; nenhum valor real deve ser versionado.
CMS_STORAGE_ENDPOINT=""
CMS_STORAGE_BUCKET=""
CMS_STORAGE_ACCESS_KEY=""
CMS_STORAGE_SECRET_KEY=""
CMS_STORAGE_PUBLIC_URL=""
CMS_STORAGE_REGION="auto"
